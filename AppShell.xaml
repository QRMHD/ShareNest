<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ShareNest.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ShareNest.Pages"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False"
       BackgroundColor="{StaticResource PageGrey}">

    <!-- Splash -> Catalog (auto). The 4 main screens use our own BottomNav control. -->
    <ShellContent Route="splash"   ContentTemplate="{DataTemplate pages:SplashPage}" />
    <ShellContent Route="catalog"  ContentTemplate="{DataTemplate pages:CatalogPage}" />
    <ShellContent Route="bookings" ContentTemplate="{DataTemplate pages:MyBookingsPage}" />
    <ShellContent Route="activity" ContentTemplate="{DataTemplate pages:ActivityPage}" />
    <ShellContent Route="profile"  ContentTemplate="{DataTemplate pages:ProfilePage}" />
</Shell>
