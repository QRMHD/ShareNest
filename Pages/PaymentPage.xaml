<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ShareNest.Pages.PaymentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:ShareNest.Controls"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageGrey}">

    <Grid RowDefinitions="Auto,*">
        <c:AppBar x:Name="PageAppBar" Title="Deposit Payment" ShowBack="True"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- 1. Order Summary Card with Method Indicator & Change Link -->
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ESCROW DEPOSIT SUMMARY" Style="{StaticResource LblCaption}"/>
                            <Border BackgroundColor="#E8F8F5" Stroke="{StaticResource Teal}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,2">
                                <Label Text="🔒 100% Refundable" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TealText}"/>
                            </Border>
                        </Grid>
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="ItemNameLbl" Style="{StaticResource LblBold}" FontSize="16"/>
                                <Label x:Name="DatesLbl" Style="{StaticResource LblMuted}" FontSize="12"/>
                            </VerticalStackLayout>
                            <Label x:Name="DepositLbl" Grid.Column="1" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="{StaticResource LineGrey}" Margin="0,2"/>

                        <!-- Current Method with Change Button -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="Payment Method:" FontSize="12" TextColor="{StaticResource SubtleText}"/>
                                <Label x:Name="SelectedMethodLbl" Text="Online Banking (FPX)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Change ▾" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TealText}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChangeMethodTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>


                <!-- ============================================================== -->
                <!-- 2A. ONLINE BANKING (FPX) SECTION                               -->
                <!-- ============================================================== -->
                <VerticalStackLayout x:Name="SectionFpx" Spacing="12" IsVisible="True">
                    <!-- FPX Header Banner -->
                    <Border BackgroundColor="#EBF3FB" Stroke="#BDD9F5" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border BackgroundColor="#005BAA" StrokeShape="RoundRectangle 4" Padding="6,4" VerticalOptions="Center">
                                <Label Text="FPX" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Financial Process Exchange (Bank Negara Malaysia)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="Select your bank for instant online direct debit" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Label Text="CHOOSE YOUR MALAYSIAN BANK" Style="{StaticResource LblCaption}" Margin="0,4,0,0"/>

                    <!-- Bank 1: Maybank -->
                    <Border x:Name="BankCard_Maybank" Style="{StaticResource Card}" Padding="12,10" Stroke="{StaticResource Teal}" StrokeThickness="2" BackgroundColor="#F0FAF9">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectMaybank"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#FFBC00" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="MBB" FontSize="11" FontAttributes="Bold" TextColor="#1C355E" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Maybank" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="Maybank2u Online" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Maybank" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource Teal}" StrokeThickness="1.6" BackgroundColor="{StaticResource Teal}" VerticalOptions="Center">
                                <Label x:Name="Check_Maybank" Text="✓" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bank 2: CIMB Bank -->
                    <Border x:Name="BankCard_Cimb" Style="{StaticResource Card}" Padding="12,10" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectCimb"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#ED1C24" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="CIMB" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="CIMB Bank" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="CIMB Clicks" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Cimb" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource LineGrey}" StrokeThickness="1.6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label x:Name="Check_Cimb" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bank 3: Public Bank -->
                    <Border x:Name="BankCard_Public" Style="{StaticResource Card}" Padding="12,10" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectPublic"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#D90000" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="PBB" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Public Bank" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="PBe Online Banking" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Public" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource LineGrey}" StrokeThickness="1.6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label x:Name="Check_Public" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bank 4: RHB Bank -->
                    <Border x:Name="BankCard_Rhb" Style="{StaticResource Card}" Padding="12,10" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectRhb"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#0072CE" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="RHB" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="RHB Bank" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="RHB Now" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Rhb" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource LineGrey}" StrokeThickness="1.6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label x:Name="Check_Rhb" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bank 5: Hong Leong Bank -->
                    <Border x:Name="BankCard_Hlb" Style="{StaticResource Card}" Padding="12,10" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectHlb"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#0C2340" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="HLB" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Hong Leong Bank" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="HLB Connect" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Hlb" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource LineGrey}" StrokeThickness="1.6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label x:Name="Check_Hlb" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bank 6: Bank Islam -->
                    <Border x:Name="BankCard_Bimb" Style="{StaticResource Card}" Padding="12,10" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectBimb"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#007A87" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="BIMB" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Bank Islam" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="BIMB Online" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Bimb" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource LineGrey}" StrokeThickness="1.6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label x:Name="Check_Bimb" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bank 7: AmBank -->
                    <Border x:Name="BankCard_Amb" Style="{StaticResource Card}" Padding="12,10" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectAmb"/></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="36" BackgroundColor="#E21836" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                                <Label Text="AMB" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="AmBank" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                <Label Text="AmOnline" FontSize="11" TextColor="{StaticResource SubtleText}"/>
                            </VerticalStackLayout>
                            <Border x:Name="Radio_Amb" Grid.Column="2" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource LineGrey}" StrokeThickness="1.6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label x:Name="Check_Amb" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- FPX Proceed Button -->
                    <Button x:Name="ProceedFpxBtn" Text="Proceed to Maybank2u (RM 20.00)" Style="{StaticResource BtnPrimary}" Clicked="OnProceedToFpxGateway" Margin="0,8,0,0"/>
                </VerticalStackLayout>


                <!-- ============================================================== -->
                <!-- 2B. DUITNOW QR SECTION                                         -->
                <!-- ============================================================== -->
                <VerticalStackLayout x:Name="SectionQr" Spacing="14" IsVisible="False">
                    <Border Stroke="#ED008C" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <!-- DuitNow Pink Header -->
                            <Grid BackgroundColor="#ED008C" Padding="14,10" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="DuitNow QR" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="MALAYSIA'S NATIONAL QR STANDARD" TextColor="White" FontSize="9" FontAttributes="Bold" Opacity="0.9"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 4" Padding="6,2">
                                    <Label Text="PayNet" FontSize="11" FontAttributes="Bold" TextColor="#ED008C"/>
                                </Border>
                            </Grid>

                            <!-- Merchant info -->
                            <VerticalStackLayout Padding="16,12,16,16" Spacing="10" HorizontalOptions="Center">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="ShareNest Community Escrow" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Navy}" HorizontalOptions="Center"/>
                                    <Label x:Name="QrRefLbl" Text="Ref: SN-84920 · Acquirer: PayNet" FontSize="11" TextColor="{StaticResource SubtleText}" HorizontalOptions="Center"/>
                                    <Label x:Name="QrAmountLbl" Text="RM 20.00" FontSize="22" FontAttributes="Bold" TextColor="#ED008C" HorizontalOptions="Center" Margin="0,2,0,0"/>
                                </VerticalStackLayout>

                                <!-- QR Canvas -->
                                <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" BackgroundColor="White" HorizontalOptions="Center">
                                    <GraphicsView x:Name="QrCanvas" WidthRequest="210" HeightRequest="210" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- Live Timer & Listening indicator -->
                                <Border BackgroundColor="#FFF0F6" Stroke="#FFD1E6" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,6" HorizontalOptions="Center">
                                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                        <Label Text="⏱️" FontSize="12" VerticalOptions="Center"/>
                                        <Label x:Name="TimerLbl" Text="Valid for 04:59" FontSize="12" FontAttributes="Bold" TextColor="#D8236B" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,2,0,0">
                                    <Label Text="🟢" FontSize="9" VerticalOptions="Center"/>
                                    <Label Text="Listening for instant push notification..." FontSize="11" TextColor="{StaticResource SubtleText}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <BoxView HeightRequest="1" Color="{StaticResource LineGrey}" Margin="0,4"/>

                                <!-- Supported Banks & Wallets Chips -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="SCAN WITH ANY MALAYSIAN BANKING OR EWALLET APP" Style="{StaticResource LblCaption}" HorizontalOptions="Center" FontSize="10"/>
                                    <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                                        <Border Margin="2" Padding="6,2" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 4"><Label Text="TNG eWallet" FontSize="10" FontAttributes="Bold" TextColor="#005BAA"/></Border>
                                        <Border Margin="2" Padding="6,2" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 4"><Label Text="Maybank MAE" FontSize="10" FontAttributes="Bold" TextColor="#1C355E"/></Border>
                                        <Border Margin="2" Padding="6,2" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 4"><Label Text="CIMB OCTO" FontSize="10" FontAttributes="Bold" TextColor="#ED1C24"/></Border>
                                        <Border Margin="2" Padding="6,2" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 4"><Label Text="GrabPay" FontSize="10" FontAttributes="Bold" TextColor="#00B14F"/></Border>
                                        <Border Margin="2" Padding="6,2" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 4"><Label Text="Boost" FontSize="10" FontAttributes="Bold" TextColor="#EE2E24"/></Border>
                                        <Border Margin="2" Padding="6,2" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 4"><Label Text="Bank Islam" FontSize="10" FontAttributes="Bold" TextColor="#007A87"/></Border>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- QR Actions -->
                    <Button Text="✓ I Have Completed Payment" Style="{StaticResource BtnPrimary}" Clicked="OnConfirmQrPaid"/>
                    <Button Text="💾 Save QR Image to Gallery" Style="{StaticResource BtnOutline}" Clicked="OnSaveQrTapped"/>
                </VerticalStackLayout>


                <!-- ============================================================== -->
                <!-- 2C. CREDIT / DEBIT CARD SECTION                                -->
                <!-- ============================================================== -->
                <VerticalStackLayout x:Name="SectionCard" Spacing="14" IsVisible="False">
                    <!-- Virtual Card Preview -->
                    <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="20,16" HeightRequest="170">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="DEBIT / CREDIT" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold"/>
                                <Label x:Name="CardBrandLbl" Grid.Column="1" Text="VISA / MC" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            </Grid>

                            <Border Grid.Row="1" WidthRequest="36" HeightRequest="26" BackgroundColor="#FCD34D" Stroke="#D97706" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4" HorizontalOptions="Start" VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Row="2" Spacing="6">
                                <Label x:Name="CardNumberDisplay" Text="•••• •••• •••• ••••" TextColor="White" FontSize="16" FontFamily="Courier" FontAttributes="Bold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="CardHolderDisplay" Text="CARDHOLDER NAME" TextColor="#CBD5E1" FontSize="11" FontAttributes="Bold"/>
                                    <Label x:Name="CardExpiryDisplay" Grid.Column="1" Text="MM/YY" TextColor="#CBD5E1" FontSize="11" FontAttributes="Bold"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Card Form Inputs -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Cardholder Name" Style="{StaticResource LblCaption}"/>
                                <Border Style="{StaticResource Field}">
                                    <Entry x:Name="CardHolderEntry" Placeholder="e.g. Amir Hassan" TextChanged="OnCardFieldChanged"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Card Number" Style="{StaticResource LblCaption}"/>
                                <Border Style="{StaticResource Field}">
                                    <Entry x:Name="CardNumberEntry" Placeholder="1234 5678 9012 3456" Keyboard="Numeric" MaxLength="19" TextChanged="OnCardFieldChanged"/>
                                </Border>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Expiry Date" Style="{StaticResource LblCaption}"/>
                                    <Border Style="{StaticResource Field}">
                                        <Entry x:Name="CardExpiryEntry" Placeholder="MM/YY" Keyboard="Numeric" MaxLength="5" TextChanged="OnCardFieldChanged"/>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="CVV (Security code)" Style="{StaticResource LblCaption}"/>
                                    <Border Style="{StaticResource Field}">
                                        <Entry x:Name="CardCvvEntry" Placeholder="123" Keyboard="Numeric" MaxLength="4" IsPassword="True" TextChanged="OnCardFieldChanged"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button x:Name="PayCardBtn" Text="Pay RM 20.00 Securely" Style="{StaticResource BtnPrimary}" Clicked="OnPayWithCard"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ============================================================== -->
        <!-- 3. SIMULATED MALAYSIAN BANK GATEWAY MODAL (FPX)                -->
        <!-- ============================================================== -->
        <Grid x:Name="BankGatewayModal" Grid.RowSpan="2" BackgroundColor="#B3000000" IsVisible="False">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" Margin="16,30" VerticalOptions="Center" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <!-- Bank Portal Top Bar -->
                    <Grid x:Name="BankHeaderBar" BackgroundColor="#FFBC00" Padding="16,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="BankPortalTitle" Text="Maybank2u Secure FPX Gateway" FontSize="15" FontAttributes="Bold" TextColor="#1C355E"/>
                            <Label Text="Official Bank Negara Malaysia FPX Merchant Portal" FontSize="10" TextColor="#1C355E" Opacity="0.8"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="🔒 SSL 256-bit" FontSize="10" FontAttributes="Bold" TextColor="#1C355E" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Bank Portal Body -->
                    <ScrollView MaximumHeightRequest="460">
                        <VerticalStackLayout Padding="18" Spacing="14">
                            <!-- Security Phrase -->
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="YOUR REGISTERED SECURITY PHRASE:" Style="{StaticResource LblCaption}" FontSize="10"/>
                                    <Label Text="SHARER-SAFE-NEST-2026" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                    <Label Text="✓ Confirmed matching registered device" FontSize="11" TextColor="{StaticResource TealText}"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Transaction Details -->
                            <Border BackgroundColor="White" Stroke="{StaticResource LineGrey}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Merchant" Style="{StaticResource LblMuted}" FontSize="12"/>
                                        <Label Text="ShareNest Escrow Platform" Grid.Column="1" Style="{StaticResource LblBold}" FontSize="12"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="FPX Reference" Style="{StaticResource LblMuted}" FontSize="12"/>
                                        <Label x:Name="GatewayRefLbl" Text="FPX-SN-84920" Grid.Column="1" Style="{StaticResource LblBold}" FontSize="12"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="From Account" Style="{StaticResource LblMuted}" FontSize="12"/>
                                        <Label Text="Savings-i (•••• 5821)" Grid.Column="1" Style="{StaticResource LblBold}" FontSize="12"/>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource LineGrey}" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Total Amount" Style="{StaticResource LblBold}" FontSize="13"/>
                                        <Label x:Name="GatewayAmountLbl" Text="RM 20.00" Grid.Column="1" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Authorization / Secure2u / TAC simulation -->
                            <Border BackgroundColor="#FFFBEB" Stroke="#FCD34D" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="SECURITY AUTHORIZATION (SECURE2U / TAC)" Style="{StaticResource LblCaption}" TextColor="#B45309"/>
                                    <Label Text="Simulated TAC Code sent to your device:" Style="{StaticResource LblMuted}" FontSize="11"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Border BackgroundColor="White" Stroke="#F59E0B" StrokeThickness="1.2" StrokeShape="RoundRectangle 6" Padding="12,6">
                                            <Label x:Name="TacCodeLbl" Text="842 195" FontSize="16" FontAttributes="Bold" TextColor="#B45309" HorizontalOptions="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Text="Use Code" FontSize="12" HeightRequest="36" Style="{StaticResource ChipOn}" Margin="8,0,0,0" Clicked="OnUseTacCode"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Modal Buttons -->
                            <Button x:Name="AuthorizeFpxBtn" Text="✓ Authorize &amp; Pay RM 20.00" Style="{StaticResource BtnPrimary}" Clicked="OnAuthorizeBankPayment"/>
                            <Button Text="Cancel and Return to ShareNest" Style="{StaticResource BtnOutline}" Clicked="OnCancelBankGateway"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>


        <!-- ============================================================== -->
        <!-- 4. MULTI-STAGE REALISTIC PROCESSING OVERLAY                    -->
        <!-- ============================================================== -->
        <Grid x:Name="ProcessingOverlay" Grid.RowSpan="2" BackgroundColor="#E61A2634" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16" Padding="24">
                <Border WidthRequest="70" HeightRequest="70" StrokeShape="RoundRectangle 35" BackgroundColor="#2A3B4C" Stroke="{StaticResource Teal}" StrokeThickness="2" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Teal}" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label x:Name="ProcessingStepLbl" Text="Connecting to Secure Payment Network..." FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label x:Name="ProcessingSubLbl" Text="Please do not close or refresh this screen" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
