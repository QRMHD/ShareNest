<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ShareNest.Pages.DepositTrustPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:ShareNest.Controls" xmlns:m="clr-namespace:ShareNest.Models"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource PageGrey}">
    <Grid RowDefinitions="Auto,*">
        <c:AppBar Title="Deposit &amp; Escrow Trust" ShowBack="True"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <!-- Escrow Status Card -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ESCROW TRUST STATUS" Style="{StaticResource LblCaption}"/>
                            <Border x:Name="StatusBadge" Grid.Column="1" BackgroundColor="White" Padding="8,2" Stroke="{StaticResource Teal}" StrokeThickness="1.2" StrokeShape="RoundRectangle 10">
                                <Label x:Name="StatusBadgeLbl" Text="🔒 HELD IN ESCROW" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TealText}"/>
                            </Border>
                        </Grid>
                        <Label x:Name="HeldLbl" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                        <Label x:Name="DeadlineLbl" Style="{StaticResource LblBody}"/>
                        <Label x:Name="TxnLbl" Style="{StaticResource LblHelper}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Payment Details Card -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PAYMENT &amp; REFUND RECEIPT" Style="{StaticResource LblCaption}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Payment Method" Style="{StaticResource LblMuted}"/>
                            <Label x:Name="PayMethodSummary" Grid.Column="1" Style="{StaticResource LblBold}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Community Lending Fee" Style="{StaticResource LblMuted}"/>
                            <Label Text="RM 0.00 (Free)" Grid.Column="1" Style="{StaticResource LblBold}" TextColor="{StaticResource TealText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Security Deposit Paid" Style="{StaticResource LblMuted}"/>
                            <Label x:Name="DepositPaidLbl" Grid.Column="1" Style="{StaticResource LblBold}"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LineGrey}" Margin="0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="RefundStatusTitle" Text="Net Refund Amount" Style="{StaticResource LblBold}"/>
                            <Label x:Name="NetRefundLbl" Grid.Column="1" Style="{StaticResource LblBold}" TextColor="{StaticResource TealText}"/>
                        </Grid>
                        <Label x:Name="RefundDescLbl" Style="{StaticResource LblHelper}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Timeline -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ESCROW LIFECYCLE TIMELINE" Style="{StaticResource LblCaption}"/>
                        <VerticalStackLayout x:Name="StepsHost" Spacing="8" Margin="4,2"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Report an issue with this deposit" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PinkText}">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnReport"/></Label.GestureRecognizers></Label>
                <Button Text="Done" Style="{StaticResource BtnPrimary}" Clicked="OnDone"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
