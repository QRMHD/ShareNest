<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ShareNest.Pages.ReservePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:ShareNest.Controls" xmlns:m="clr-namespace:ShareNest.Models"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource PageGrey}">
    <Grid RowDefinitions="Auto,*">
        <c:AppBar Title="Reserve item" ShowBack="True"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <!-- Calendar -->
                <Border Style="{StaticResource Card}" Padding="12,10">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="‹" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Navy}" Padding="6,0">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnPrev"/></Label.GestureRecognizers></Label>
                            <Label x:Name="MonthLbl" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource LblBold}"/>
                            <Label Text="›" Grid.Column="2" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Navy}" Padding="6,0">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNext"/></Label.GestureRecognizers></Label>
                        </Grid>
                        <Grid x:Name="Cal" ColumnSpacing="4" RowSpacing="4"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Dates summary -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="3">
                        <Label x:Name="SumTitle" Style="{StaticResource LblCaption}"/>
                        <Label x:Name="SumDates" Style="{StaticResource LblBold}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Pickup Time Slot -->
                <Border Style="{StaticResource Field}" Stroke="{StaticResource Navy}" StrokeThickness="1.4">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTime"/></Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="TimeLbl" Style="{StaticResource LblBold}" VerticalOptions="Center"/>
                        <Label x:Name="DateLbl" Grid.Column="1" Style="{StaticResource LblCaption}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Clear Cost & Deposit Breakdown -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="COST &amp; DEPOSIT BREAKDOWN" Style="{StaticResource LblCaption}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Community Borrowing" Style="{StaticResource LblMuted}"/>
                            <Label Text="RM 0.00 (Free)" Grid.Column="1" Style="{StaticResource LblBold}" TextColor="{StaticResource TealText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Refundable Security Deposit" Style="{StaticResource LblMuted}"/>
                            <Label x:Name="SumDeposit" Grid.Column="1" Style="{StaticResource LblBold}"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LineGrey}" Margin="0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total Due Now" Style="{StaticResource LblBold}"/>
                            <Label x:Name="TotalPayableLbl" Grid.Column="1" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}"/>
                        </Grid>
                        <Label Text="✓ 100% refunded when returned in good condition" Style="{StaticResource LblHelper}" FontSize="12" TextColor="{StaticResource TealText}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Payment Method Selection -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="CHOOSE PAYMENT METHOD" Style="{StaticResource LblCaption}"/>
                        <Border Style="{StaticResource Field}" BackgroundColor="White">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSelectPaymentMethod"/></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="PayMethodLbl" Text="📱 DuitNow QR / TNG eWallet" Style="{StaticResource LblBold}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Change ▾" Style="{StaticResource LblCaption}" TextColor="{StaticResource TealText}" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                        <Label Text="Held securely in ShareNest Escrow until item return." Style="{StaticResource LblHelper}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Late Return Policy -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="LATE RETURN POLICY" Style="{StaticResource LblCaption}"/>
                        <Label Text="RM 5/day fee applies if returned after deadline" Style="{StaticResource LblBold}"/>
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="ConfirmBtn" Text="Pay Deposit &amp; Confirm (RM 20.00)" Style="{StaticResource BtnPrimary}" Clicked="OnConfirm"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
