<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ShareNest.Pages.HandoverLogPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:ShareNest.Controls" xmlns:m="clr-namespace:ShareNest.Models"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource PageGrey}">
    <Grid RowDefinitions="Auto,*">
        <c:AppBar Title="Handover" ShowBack="True"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <HorizontalStackLayout x:Name="StepChips" Spacing="6"/>
                <Label x:Name="ItemLbl" Style="{StaticResource LblMuted}"/>

                <!-- Single condition photo -->
                <Border x:Name="PhotoBox" Style="{StaticResource Card}" HeightRequest="140" Padding="0">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPhotoTapped"/></Border.GestureRecognizers>
                    <Grid>
                        <Image x:Name="PhotoImg" Aspect="AspectFill"/>
                        <VerticalStackLayout x:Name="PhotoHint" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="ic_camera.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center"/>
                            <Label Text="Take condition photo — tap to capture" Style="{StaticResource LblBold}" FontSize="13" HorizontalOptions="Center"/>
                            <Label Text="Capture any existing marks or wear" Style="{StaticResource LblHelper}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Note entry -->
                <Border Style="{StaticResource Field}"><Entry x:Name="NoteEntry" Placeholder="Condition note (e.g. good condition, clean)"/></Border>

                <!-- Single Handover Confirmation -->
                <Border Style="{StaticResource Panel}">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnConfirmToggle"/></Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                        <Border x:Name="CheckSquare" WidthRequest="22" HeightRequest="22" Padding="0"
                                StrokeShape="RoundRectangle 6" Stroke="{StaticResource Navy}" StrokeThickness="1.6"
                                BackgroundColor="{StaticResource Navy}" VerticalOptions="Center">
                            <Label x:Name="CheckIcon" Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Verify &amp; Confirm Handover" Style="{StaticResource LblBold}" FontSize="14"/>
                            <Label Text="I have inspected the item and verify its condition" Style="{StaticResource LblHelper}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label x:Name="StampLbl" Text="Timestamp: auto-captured on confirm" Style="{StaticResource LblMuted}"/>

                <Button Text="Confirm handover" Style="{StaticResource BtnPrimary}" Clicked="OnConfirm"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
