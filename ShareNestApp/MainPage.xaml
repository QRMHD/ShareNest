<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShareNest.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Explore"
    BackgroundColor="#F7F8FA">
    <Grid Padding="24,32" RowDefinitions="Auto,*" RowSpacing="24">
        <VerticalStackLayout Spacing="6">
            <Label Text="ShareNest" FontSize="14" FontAttributes="Bold" TextColor="#547A64" />
            <Label Text="Borrow nearby. Share more." FontSize="28" FontAttributes="Bold" TextColor="#202923" />
            <Label Text="Useful things, shared by your community." FontSize="15" TextColor="#68736B" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" BackgroundColor="White" Stroke="#E5E9E6" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                            <Label Text="{Binding Icon}" FontSize="30" VerticalOptions="Center" HorizontalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" TextColor="#202923" />
                                <Label Text="{Binding Category}" FontSize="13" TextColor="#68736B" />
                                <Label Text="{Binding Distance}" FontSize="12" TextColor="#547A64" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Deposit, StringFormat='${0} deposit'}" FontSize="12" TextColor="#68736B" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>